# Main routing logic
case "$1" in
    up)
        ensure_ssl
        shift
        # Never let empty Tailscale values reach the nginx template
        TAILSCALE_DOMAIN="$(get_env TAILSCALE_DOMAIN share.test)"
        TAILSCALE_PROJECT_PATH="$(get_env TAILSCALE_PROJECT_PATH dashboard)"
        export TAILSCALE_DOMAIN TAILSCALE_PROJECT_PATH
        use_tools=false
        args=()
        for arg in "$@"; do
            if [[ "$arg" == "--tools" || "$arg" == "--all" ]]; then
                use_tools=true
            else
                args+=("$arg")
            fi
        done

        if [ "$use_tools" = true ]; then
            docker compose -f "$SCRIPT_DIR/docker-compose.yml" --profile tools up -d "${args[@]}"
        else
            docker compose -f "$SCRIPT_DIR/docker-compose.yml" up -d "${args[@]}"
        fi
        ;;

    down)
        shift
        docker compose -f "$SCRIPT_DIR/docker-compose.yml" --profile tools down "$@"
        ;;

    restart)
        shift
        docker compose -f "$SCRIPT_DIR/docker-compose.yml" restart "$@"
        ;;

    logs)
        shift
        docker compose -f "$SCRIPT_DIR/docker-compose.yml" logs "$@"
        ;;

    status|ps)
        shift
        docker compose -f "$SCRIPT_DIR/docker-compose.yml" ps "$@"
        ;;

    ssl)
        generate_ssl
        ;;

    dns)
        shift
        case "$1" in
            setup)
                setup_dns
                ;;
            status)
                check_dns_status
                ;;
            teardown|uninstall|remove)
                teardown_dns
                ;;
            *)
                echo "Usage: ./dev dns [setup|status|teardown]"
                ;;
        esac
        ;;

    new)
        shift
        if [[ -z "${1:-}" ]]; then
            echo "❌ Error: Project name required."
            echo "Usage: ./dev new <project_name> [--type=laravel|wordpress|symfony|vite|blank] [--php=8.5|8.4|8.3|8.2] [--db=mariadb|postgres]"
            exit 1
        fi

        proj_name="$1"
        shift
        type="laravel"
        php_ver="$(default_php_display)"
        db_type="mariadb"

        for arg in "$@"; do
            case $arg in
                --type=*) type="${arg#*=}" ;;
                --php=*) php_ver="${arg#*=}" ;;
                --db=*) db_type="${arg#*=}" ;;
            esac
        done

        # Normalize database selection to real service + driver names
        case "$db_type" in
            mariadb|mysql)
                db_service="mariadb"
                db_conn="mysql"
                db_port="3306"
                db_user_cfg="$(get_env MARIADB_USER db_user)"
                db_pass_cfg="$(get_env MARIADB_PASSWORD db_password)"
                ;;
            postgres|pgsql)
                db_service="postgres"
                db_conn="pgsql"
                db_port="5432"
                db_user_cfg="$(get_env POSTGRES_USER db_user)"
                db_pass_cfg="$(get_env POSTGRES_PASSWORD db_password)"
                ;;
            *)
                echo "❌ Error: Unknown database type '$db_type' (use mariadb or postgres)."
                exit 1
                ;;
        esac

        php_container=$(get_php_container "$php_ver")
        target_dir="$PROJECTS_DIR/$proj_name"

        if [[ -d "$target_dir" ]]; then
            echo "❌ Error: Directory projects/$proj_name already exists!"
            exit 1
        fi

        echo "🚀 Scaffolding new '$type' project '$proj_name' (PHP $php_ver, DB: $db_service)..."

        db_name="${proj_name//-/_}"
        create_db_if_not_exists "$db_service" "$db_name"

        mkdir -p "$target_dir"

        if [[ "$type" == "laravel" ]]; then
            echo "📦 Running 'composer create-project laravel/laravel'..."
            docker exec -it -w "/var/www/html" "$php_container" composer create-project laravel/laravel "$proj_name"

            if [[ -f "$target_dir/.env" ]]; then
                # Laravel ships DB_CONNECTION=sqlite and commented-out DB_* keys,
                # so replace-or-append instead of naive sed substitutions.
                set_env_key "$target_dir/.env" DB_CONNECTION "$db_conn"
                set_env_key "$target_dir/.env" DB_HOST "$db_service"
                set_env_key "$target_dir/.env" DB_PORT "$db_port"
                set_env_key "$target_dir/.env" DB_DATABASE "$db_name"
                set_env_key "$target_dir/.env" DB_USERNAME "$db_user_cfg"
                set_env_key "$target_dir/.env" DB_PASSWORD "$db_pass_cfg"
                set_env_key "$target_dir/.env" REDIS_HOST "redis"
                set_env_key "$target_dir/.env" MAIL_MAILER "smtp"
                set_env_key "$target_dir/.env" MAIL_HOST "mailpit"
                set_env_key "$target_dir/.env" MAIL_PORT "1025"
                set_env_key "$target_dir/.env" APP_URL "https://${proj_name}.$(get_env DOMAIN_SUFFIX test)"
            fi
            echo "✅ Laravel project '$proj_name' created successfully!"

        elif [[ "$type" == "symfony" ]]; then
            echo "📦 Running 'composer create-project symfony/skeleton'..."
            docker exec -it -w "/var/www/html" "$php_container" composer create-project symfony/skeleton "$proj_name"
            echo "✅ Symfony project '$proj_name' created successfully!"

        elif [[ "$type" == "vite" ]]; then
            echo "📦 Setting up Vite frontend app..."
            docker exec -it -w "/var/www/html" "$php_container" npm create vite@latest "$proj_name" -- --template vanilla
            echo "✅ Vite project '$proj_name' created successfully!"

        elif [[ "$type" == "wordpress" ]]; then
            echo "📦 Setting up WordPress..."
            curl -sSL https://wordpress.org/latest.tar.gz | tar -xz -C "$PROJECTS_DIR"
            mv "$PROJECTS_DIR/wordpress" "$target_dir"

            cat <<EOF > "$target_dir/wp-config.php"
<?php
define( 'DB_NAME', '${db_name}' );
define( 'DB_USER', '${db_user_cfg}' );
define( 'DB_PASSWORD', '${db_pass_cfg}' );
define( 'DB_HOST', '${db_service}' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

\$table_prefix = 'wp_';
define( 'WP_DEBUG', true );

if ( ! defined( 'ABSPATH' ) ) {
    define( 'ABSPATH', __DIR__ . '/' );
}
require_once ABSPATH . 'wp-settings.php';
EOF
            echo "✅ WordPress project '$proj_name' created successfully!"

        else
            echo "📦 Setting up Blank/Vanilla PHP project..."
            cat <<EOF > "$target_dir/index.php"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${proj_name} - localDev</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; display: grid; place-content: center; min-height: 100vh; margin: 0; }
        .card { background: #1e293b; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); text-align: center; max-width: 500px; }
        h1 { color: #38bdf8; margin-bottom: 0.5rem; }
        p { color: #94a3b8; }
        .badge { background: #0284c7; padding: 4px 10px; border-radius: 9999px; font-size: 0.875rem; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🚀 ${proj_name}</h1>
        <p>Your localDev environment is ready!</p>
        <p><span class="badge">PHP <?php echo phpversion(); ?></span></p>
    </div>
</body>
</html>
EOF
            echo "✅ Blank project '$proj_name' created successfully!"
        fi

        # Standardize .env file for projects that do not already have one
        if [[ ! -f "$target_dir/.env" ]]; then
            cat <<EOF > "$target_dir/.env"
APP_NAME="${proj_name}"
APP_ENV=local
DB_CONNECTION=${db_conn}
DB_HOST=${db_service}
DB_PORT=${db_port}
DB_DATABASE=${db_name}
DB_USERNAME=${db_user_cfg}
DB_PASSWORD=${db_pass_cfg}
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_HOST=mailpit
MAIL_PORT=1025
EOF
            echo "📄 Generated standardized project '.env' file with database & service credentials."
        fi

        echo ""
        echo "🌐 Available Test URLs:"
        echo "  - HTTPS (Default $(default_php_version)): https://${proj_name}.test"
        echo "  - HTTPS (PHP 8.5):     https://${proj_name}.php85.test"
        echo "  - HTTPS (PHP 8.4):     https://${proj_name}.php84.test"
        echo "  - HTTPS (PHP 8.3):     https://${proj_name}.php83.test"
        echo "  - HTTPS (PHP 8.2):     https://${proj_name}.php82.test"
        echo "  - HTTP (Fallback):     http://localhost:$(get_env NGINX_PORT_PHP84 8084)/${proj_name}"
        ;;

    list)
        port82="$(get_env NGINX_PORT_PHP82 8082)"
        port83="$(get_env NGINX_PORT_PHP83 8083)"
        port84="$(get_env NGINX_PORT_PHP84 8084)"
        port85="$(get_env NGINX_PORT_PHP85 8085)"

        echo "========================================================================================="
        echo " 📁 localDev Projects Overview"
        echo "========================================================================================="
        printf "%-18s %-12s %-32s %-25s\n" "PROJECT" "TYPE" "HTTPS DOMAIN (*.test)" "PORT FALLBACK"
        echo "-----------------------------------------------------------------------------------------"

        for pdir in "$PROJECTS_DIR"/*; do
            if [[ -d "$pdir" ]]; then
                pname="$(basename "$pdir")"
                ptype="Vanilla/PHP"
                if [[ -f "$pdir/artisan" ]]; then
                    ptype="Laravel"
                elif [[ -f "$pdir/wp-config.php" ]]; then
                    ptype="WordPress"
                elif [[ -f "$pdir/symfony.lock" ]]; then
                    ptype="Symfony"
                elif [[ -f "$pdir/vite.config.js" || -f "$pdir/vite.config.ts" ]]; then
                    ptype="Vite/Node"
                fi

                domain="https://${pname}.test"
                fallback="http://localhost:${port84}/${pname}"

                printf "%-18s %-12s %-32s %-25s\n" "$pname" "$ptype" "$domain" "$fallback"
            fi
        done
        echo "========================================================================================="
        echo " Port fallbacks: :${port85} (php85) :${port84} (php84) :${port83} (php83) :${port82} (php82)"
        echo "========================================================================================="
        ;;

    composer)
        shift
        run_tool composer "$@"
        ;;

    artisan)
        shift
        proj=$(detect_current_project)

        if [[ -n "${1:-}" ]] && [[ -d "$PROJECTS_DIR/$1" ]]; then
            proj="$1"
            shift
        fi

        if [[ -z "$proj" ]]; then
            echo "❌ Error: Could not determine target project name."
            echo "Usage: ./dev artisan <project-name> <command>  (or run from inside projects/<project-name>)"
            exit 1
        fi

        docker exec -it -w "/var/www/html/$proj" "$(get_php_container "")" php artisan "$@"
        ;;

    php)
        shift
        run_tool php "$@"
        ;;

    npm)
        shift
        run_tool npm "$@"
        ;;

    npx)
        shift
        run_tool npx "$@"
        ;;

    node)
        shift
        run_tool node "$@"
        ;;

    db)
        shift
        action="$1"
        shift || true
        db_type="${1:-}"
        shift || true

        if [[ "$action" == "shell" ]]; then
            if [[ "$db_type" == "mariadb" || "$db_type" == "mysql" ]]; then
                wait_for_container_health "local-mariadb" 10
                echo "💻 Connecting to MariaDB interactive shell..."
                docker exec -it local-mariadb mariadb \
                    -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
                    "$(get_env MARIADB_DATABASE local_db)"
            elif [[ "$db_type" == "postgres" || "$db_type" == "pgsql" ]]; then
                wait_for_container_health "local-postgres" 10
                echo "💻 Connecting to PostgreSQL interactive shell..."
                docker exec -it local-postgres psql -U "$(get_env POSTGRES_USER db_user)" -d "$(get_env POSTGRES_DB local_db)"
            else
                echo "Usage: ./dev db shell <mariadb|postgres>"
            fi

        elif [[ "$action" == "backup" ]]; then
            outfile="${1:-${db_type}_backup_$(date +%Y%m%d_%H%M%S).sql}"
            if [[ "$db_type" == "mariadb" || "$db_type" == "mysql" ]]; then
                wait_for_container_health "local-mariadb" 10
                echo "📦 Exporting MariaDB to $outfile..."
                docker exec -i local-mariadb mariadb-dump \
                    -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
                    "$(get_env MARIADB_DATABASE local_db)" > "$outfile"
                echo "✅ Mariadb dump completed: $outfile"
            elif [[ "$db_type" == "postgres" || "$db_type" == "pgsql" ]]; then
                wait_for_container_health "local-postgres" 10
                echo "📦 Exporting PostgreSQL to $outfile..."
                # Never use `docker exec -t` here: the TTY corrupts the dump with CRLF line endings
                docker exec -i local-postgres pg_dump -U "$(get_env POSTGRES_USER db_user)" \
                    "$(get_env POSTGRES_DB local_db)" > "$outfile"
                echo "✅ PostgreSQL dump completed: $outfile"
            else
                echo "❌ Unknown db_type: $db_type (Use 'mariadb' or 'postgres')"
                exit 1
            fi
        elif [[ "$action" == "restore" ]]; then
            infile="$1"
            if [[ ! -f "$infile" ]]; then
                echo "❌ Restore file not found: $infile"
                exit 1
            fi
            if [[ "$db_type" == "mariadb" || "$db_type" == "mysql" ]]; then
                wait_for_container_health "local-mariadb" 10
                echo "📥 Importing $infile into MariaDB..."
                docker exec -i local-mariadb mariadb \
                    -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
                    "$(get_env MARIADB_DATABASE local_db)" < "$infile"
                echo "✅ Mariadb restore completed!"
            elif [[ "$db_type" == "postgres" || "$db_type" == "pgsql" ]]; then
                wait_for_container_health "local-postgres" 10
                echo "📥 Importing $infile into PostgreSQL..."
                docker exec -i local-postgres psql -U "$(get_env POSTGRES_USER db_user)" \
                    -d "$(get_env POSTGRES_DB local_db)" < "$infile"
                echo "✅ PostgreSQL restore completed!"
            else
                echo "❌ Unknown db_type: $db_type (Use 'mariadb' or 'postgres')"
                exit 1
            fi
        else
            echo "Usage: ./dev db shell <mariadb|postgres>"
            echo "       ./dev db backup <mariadb|postgres> [file.sql]"
            echo "       ./dev db restore <mariadb|postgres> <file.sql>"
        fi
        ;;

    snapshot)
        shift
        subcmd="${1:-list}"
        case "$subcmd" in
            save)
                shift
                snapshot_save "$@"
                ;;
            restore)
                shift
                snapshot_restore "$@"
                ;;
            list)
                snapshot_list
                ;;
            delete|rm)
                shift
                snapshot_delete "$@"
                ;;
            *)
                echo "Usage: ./dev snapshot [save|restore|list|delete] [name]"
                exit 1
                ;;
        esac
        ;;

    test)
        shift
        target="${1:-all}"
        if [[ "$target" == "unit" ]]; then
            bash "${SCRIPT_DIR}/tests/cli_unit_test.sh"
        elif [[ "$target" == "integration" ]]; then
            bash "${SCRIPT_DIR}/tests/cli_integration_test.sh"
        elif [[ "$target" == "all" ]]; then
            bash "${SCRIPT_DIR}/tests/cli_unit_test.sh"
            echo ""
            bash "${SCRIPT_DIR}/tests/cli_integration_test.sh"
        else
            echo "Usage: ./dev test [unit|integration|all]"
            exit 1
        fi
        ;;

    completion)
        shell="${2:-bash}"
        if [[ "$shell" == "install" ]]; then
            install_completion
        elif [[ "$shell" == "zsh" ]]; then
            cat <<'EOF'
#compdef dev
_dev() {
    local -a commands
    commands=(
        'up:Start Docker containers'
        'down:Stop Docker containers'
        'restart:Restart containers'
        'logs:View container logs'
        'status:View running containers status'
        'ps:View running containers status'
        'ssl:Generate SSL certs'
        'dns:Configure or test *.test DNS resolution'
        'new:Scaffold new project'
        'list:List local projects'
        'composer:Run Composer inside container'
        'artisan:Run Artisan command'
        'php:Run PHP command'
        'npm:Run NPM command'
        'npx:Run NPX command'
        'node:Run Node command'
        'db:Database backup/restore/shell'
        'snapshot:Manage environment snapshots'
        'test:Run unit and integration tests'
        'completion:Shell autocompletion'
        'help:Show help'
    )
    _describe 'command' commands
}
compdef _dev dev
EOF
        elif [[ "$shell" == "fish" ]]; then
            cat <<'EOF'
# Fish completion for dev CLI
complete -c dev -f
complete -c dev -n "__fish_use_subcommand" -a "up" -d "Start Docker containers"
complete -c dev -n "__fish_use_subcommand" -a "down" -d "Stop Docker containers"
complete -c dev -n "__fish_use_subcommand" -a "restart" -d "Restart containers"
complete -c dev -n "__fish_use_subcommand" -a "logs" -d "View container logs"
complete -c dev -n "__fish_use_subcommand" -a "status" -d "View running containers status"
complete -c dev -n "__fish_use_subcommand" -a "ps" -d "View running containers status"
complete -c dev -n "__fish_use_subcommand" -a "ssl" -d "Generate or renew SSL certs"
complete -c dev -n "__fish_use_subcommand" -a "dns" -d "Configure or test *.test DNS resolution"
complete -c dev -n "__fish_use_subcommand" -a "new" -d "Scaffold new project"
complete -c dev -n "__fish_use_subcommand" -a "list" -d "List local projects"
complete -c dev -n "__fish_use_subcommand" -a "composer" -d "Run Composer inside container"
complete -c dev -n "__fish_use_subcommand" -a "artisan" -d "Run Artisan command"
complete -c dev -n "__fish_use_subcommand" -a "php" -d "Run PHP CLI inside container"
complete -c dev -n "__fish_use_subcommand" -a "npm" -d "Run NPM inside container"
complete -c dev -n "__fish_use_subcommand" -a "npx" -d "Run NPX inside container"
complete -c dev -n "__fish_use_subcommand" -a "node" -d "Run Node script inside container"
complete -c dev -n "__fish_use_subcommand" -a "db" -d "Database backup/restore/shell"
complete -c dev -n "__fish_use_subcommand" -a "snapshot" -d "Manage environment snapshots"
complete -c dev -n "__fish_use_subcommand" -a "test" -d "Run unit and integration tests"
complete -c dev -n "__fish_use_subcommand" -a "completion" -d "Shell autocompletion installer"
complete -c dev -n "__fish_use_subcommand" -a "help" -d "Show help"
EOF
        else
            cat <<'EOF'
_dev_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="up down restart logs status ps ssl dns new list composer artisan php npm npx node db snapshot test help completion"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
        return 0
    fi
}
complete -F _dev_completion dev ./dev
EOF
        fi
        ;;

    help|--help|-h|"")
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
