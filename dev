#!/usr/bin/env bash
set -e

# Default Docker Compose build parallelism to 1 to prevent CPU/RAM thrashing
export COMPOSE_PARALLEL_LIMIT="${COMPOSE_PARALLEL_LIMIT:-1}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CERTS_DIR="${SCRIPT_DIR}/nginx/certs"
PROJECTS_DIR="${SCRIPT_DIR}/projects"
SNAPSHOTS_DIR="${SCRIPT_DIR}/snapshots"

# Helper: Read a key from .env (falls back to default)
get_env() {
    local key="$1" default="${2:-}" value=""
    if [[ -f "${SCRIPT_DIR}/.env" ]]; then
        value="$(grep -E "^${key}=" "${SCRIPT_DIR}/.env" | tail -n1 | cut -d '=' -f2- | tr -d ' "')"
    fi
    echo "${value:-$default}"
}

# Helper: Set (or replace) KEY=VALUE in an env file, uncommenting if needed
set_env_key() {
    local file="$1" key="$2" value="$3" esc
    esc="${value//\\/\\\\}"
    esc="${esc//&/\\&}"
    esc="${esc//|/\\|}"
    if grep -qE "^[[:space:]]*#?[[:space:]]*${key}=" "$file"; then
        sed -i -E "s|^[[:space:]]*#?[[:space:]]*${key}=.*|${key}=${esc}|" "$file"
    else
        printf '%s=%s\n' "$key" "$value" >> "$file"
    fi
}

# Helper: Default PHP service name (e.g. php85) from .env DEFAULT_PHP_VERSION
default_php_version() {
    get_env DEFAULT_PHP_VERSION "php85"
}

# Helper: Default PHP version for display (e.g. 8.5)
default_php_display() {
    local s
    s="$(default_php_version)"
    s="${s#php}"
    echo "8.${s:1:1}"
}

# Helper: Detect current project if inside projects/ subdirectory
detect_current_project() {
    local cwd
    cwd="$(pwd)"
    if [[ "$cwd" == "$PROJECTS_DIR"* ]] && [[ "$cwd" != "$PROJECTS_DIR" ]]; then
        local rel_path="${cwd#$PROJECTS_DIR/}"
        echo "${rel_path%%/*}"
    else
        echo ""
    fi
}

# Helper: Ensure SSL certs exist and are valid (auto-renews if expiring within 30 days)
ensure_ssl() {
    mkdir -p "$CERTS_DIR"
    local needs_cert=false

    if [[ ! -f "$CERTS_DIR/local-dev.crt" ]] || [[ ! -f "$CERTS_DIR/local-dev.key" ]]; then
        needs_cert=true
    elif command -v openssl &>/dev/null; then
        # 2592000 seconds = 30 days
        if ! openssl x509 -checkend 2592000 -noout -in "$CERTS_DIR/local-dev.crt" &>/dev/null; then
            echo "⚠️ Local SSL certificate is expired or expiring within 30 days. Auto-renewing..."
            needs_cert=true
        fi
    fi

    if [[ "$needs_cert" == "true" ]]; then
        generate_ssl
    fi
}

# Generate SSL certificates (hybrid mkcert / openssl fallback)
generate_ssl() {
    mkdir -p "$CERTS_DIR"
    if command -v mkcert &> /dev/null; then
        echo "🔒 Using mkcert to generate trusted local SSL certificates..."
        mkcert -cert-file "$CERTS_DIR/local-dev.crt" -key-file "$CERTS_DIR/local-dev.key" \
            "*.php82.test" "*.php83.test" "*.php84.test" "*.php85.test" "*.test" \
            "dashboard.test" "dashboard.php82.test" "dashboard.php83.test" "dashboard.php84.test" "dashboard.php85.test" \
            localhost 127.0.0.1 ::1
        echo "✅ Trusted SSL certificates generated at nginx/certs/"
    else
        echo "⚠️ mkcert not found on host system. Falling back to OpenSSL self-signed certificate..."
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout "$CERTS_DIR/local-dev.key" \
            -out "$CERTS_DIR/local-dev.crt" \
            -subj "/C=US/ST=Local/L=Local/O=LocalDev/OU=Dev/CN=*.test" \
            &> /dev/null
        echo "✅ Self-signed SSL certificate generated at nginx/certs/"
        echo "💡 Note: Install 'mkcert' on your host system for browser-trusted local HTTPS!"
    fi

    reload_nginx_if_running
}

# Reload nginx config (and pick up renewed certs) when the container is running
reload_nginx_if_running() {
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-nginx$"; then
        docker exec local-nginx nginx -s reload &>/dev/null || true
    fi
}

# Helper: Wait for container to be healthy (up to timeout seconds)
wait_for_container_health() {
    local container_name="$1"
    local timeout="${2:-10}"
    local count=0

    # Skip check if container does not exist
    if ! docker inspect "$container_name" &>/dev/null; then
        return 0
    fi

    local inspect_health
    inspect_health=$(docker inspect --format='{{json .State.Health}}' "$container_name" 2>/dev/null)
    if [[ "$inspect_health" == "null" || -z "$inspect_health" ]]; then
        return 0
    fi

    echo "⏳ Checking health status for ${container_name}..."
    while [[ $count -lt $timeout ]]; do
        local status
        status=$(docker inspect --format='{{json .State.Health.Status}}' "$container_name" 2>/dev/null | tr -d '"')

        if [[ "$status" == "healthy" ]]; then
            echo "✅ Container ${container_name} is healthy and ready!"
            return 0
        elif [[ "$status" == "unhealthy" ]]; then
            echo "⚠️ Container ${container_name} healthcheck reported unhealthy status."
            return 1
        fi

        sleep 1
        count=$((count + 1))
    done

    echo "⚠️ Timed out waiting for ${container_name} health (proceeding...)"
    return 0
}

# Auto-create database if not exists
create_db_if_not_exists() {
    local db_type="$1"
    local db_name="$2"
    db_name="${db_name//-/_}" # sanitize hyphens to underscores for DB names

    if [[ "$db_type" == "mariadb" || "$db_type" == "mysql" ]]; then
        wait_for_container_health "local-mariadb" 10
        echo "🗄️  Checking/Creating MariaDB database: ${db_name}..."
        docker exec -i local-mariadb mariadb \
            -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
            -e "CREATE DATABASE IF NOT EXISTS \`${db_name}\`;" || {
            echo "⚠️ Could not auto-create MariaDB database (make sure containers are running with './dev up')."
        }
    elif [[ "$db_type" == "postgres" || "$db_type" == "pgsql" ]]; then
        wait_for_container_health "local-postgres" 10
        echo "🗄️  Checking/Creating PostgreSQL database: ${db_name}..."
        local pg_user exists
        pg_user="$(get_env POSTGRES_USER db_user)"
        exists="$(docker exec -i local-postgres psql -U "$pg_user" -d postgres -tAc \
            "SELECT 1 FROM pg_database WHERE datname='${db_name}';" 2>/dev/null || true)"
        if [[ "$exists" != "1" ]]; then
            docker exec -i local-postgres psql -U "$pg_user" -d postgres -c "CREATE DATABASE \"${db_name}\";" || {
                echo "⚠️ Could not auto-create PostgreSQL database (make sure containers are running with './dev up')."
            }
        fi
    fi
}

# Setup local DNS resolution (*.test)
setup_dns() {
    echo "🌐 Setting up local DNS resolution for *.test domains..."

    local os dns_port resolved_service
    os="$(uname -s)"
    dns_port="$(get_env DNSMASQ_PORT 5354)"

    if [[ "$os" == "Linux" ]]; then
        # Detect systemd-resolved by service file existence (works even when disabled)
        resolved_service=""
        for f in /lib/systemd/system/systemd-resolved.service \
                  /usr/lib/systemd/system/systemd-resolved.service; do
            if [[ -f "$f" ]]; then
                resolved_service="$f"
                break
            fi
        done

        if [[ -n "$resolved_service" ]]; then
            echo "🔧 Configuring systemd-resolved for *.test domains..."
            sudo mkdir -p /etc/systemd/resolved.conf.d
            cat <<EOF | sudo tee /etc/systemd/resolved.conf.d/localdev.conf > /dev/null
[Resolve]
DNS=127.0.0.1:${dns_port}
Domains=~test
EOF
            echo "🔄 Enabling and restarting systemd-resolved..."
            sudo systemctl enable --now systemd-resolved 2>/dev/null || true
            sudo systemctl restart systemd-resolved
            # Point resolv.conf at systemd-resolved's stub listener
            if [[ -e /run/systemd/resolve/stub-resolv.conf ]]; then
                sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
            fi
            echo "✅ systemd-resolved configured successfully for *.test domains!"
        elif [[ -d /etc/NetworkManager/conf.d ]]; then
            echo "🔧 Configuring NetworkManager dnsmasq plugin for *.test domains..."
            echo -e "[main]\ndns=dnsmasq" | sudo tee /etc/NetworkManager/conf.d/00-use-dnsmasq.conf > /dev/null
            sudo mkdir -p /etc/NetworkManager/dnsmasq.d
            echo "server=/test/127.0.0.1#${dns_port}" | sudo tee /etc/NetworkManager/dnsmasq.d/localdev.conf > /dev/null
            sudo systemctl restart NetworkManager
            echo "✅ NetworkManager configured successfully!"
        else
            echo "⚠️ Could not auto-detect systemd-resolved or NetworkManager."
            echo "💡 Please add 'nameserver 127.0.0.1' or point port ${dns_port} in your resolver configuration."
        fi
    elif [[ "$os" == "Darwin" ]]; then
        echo "🔧 Configuring macOS resolver for *.test domains..."
        sudo mkdir -p /etc/resolver
        cat <<EOF | sudo tee /etc/resolver/test > /dev/null
nameserver 127.0.0.1
port ${dns_port}
EOF
        echo "✅ macOS resolver created at /etc/resolver/test!"
    else
        echo "ℹ️ On Windows/WSL2, ensure local-dnsmasq container is running and route *.test requests to 127.0.0.1."
    fi

    echo ""
    check_dns_status
}

# Test local DNS resolution status
check_dns_status() {
    echo "🔍 Checking *.test DNS resolution status..."
    local test_domain="localdev-test.test"
    local resolved_ip=""
    local dns_port
    dns_port="$(get_env DNSMASQ_PORT 5354)"

    if command -v dig &>/dev/null; then
        resolved_ip="$(dig +short @127.0.0.1 -p ${dns_port} "$test_domain" 2>/dev/null | tail -n1)"
    elif command -v nslookup &>/dev/null; then
        resolved_ip="$(nslookup -port=${dns_port} "$test_domain" 127.0.0.1 2>/dev/null | grep -A1 "Name:" | grep "Address:" | awk '{print $2}')"
    fi

    if [[ "$resolved_ip" == "127.0.0.1" ]]; then
        echo "✅ Dnsmasq container (127.0.0.1:${dns_port}) is resolving *.test domains correctly to 127.0.0.1"
    else
        echo "⚠️ Direct query to Dnsmasq container (127.0.0.1:${dns_port}) returned: '${resolved_ip:-no response}'"
        echo "💡 Make sure containers are started with './dev up'."
    fi

    if command -v ping &>/dev/null; then
        if ping -c 1 -W 1 "$test_domain" &>/dev/null; then
            echo "✅ Host OS resolver successfully resolves *.test domains!"
        else
            echo "ℹ️ Host OS ping test to $test_domain did not resolve. Run './dev dns setup' to configure host DNS."
        fi
    fi
}

# Remove local DNS setup
teardown_dns() {
    echo "🧹 Cleaning up local DNS configurations..."
    local os
    os="$(uname -s)"

    if [[ "$os" == "Linux" ]]; then
        if [[ -f /etc/systemd/resolved.conf.d/localdev.conf ]]; then
            sudo rm -f /etc/systemd/resolved.conf.d/localdev.conf
            sudo systemctl restart systemd-resolved 2>/dev/null || true
            echo "✅ Removed /etc/systemd/resolved.conf.d/localdev.conf"
        fi
        if [[ -f /etc/NetworkManager/dnsmasq.d/localdev.conf ]]; then
            sudo rm -f /etc/NetworkManager/dnsmasq.d/localdev.conf
            sudo systemctl restart NetworkManager 2>/dev/null || true
            echo "✅ Removed /etc/NetworkManager/dnsmasq.d/localdev.conf"
        fi
    elif [[ "$os" == "Darwin" ]]; then
        if [[ -f /etc/resolver/test ]]; then
            sudo rm -f /etc/resolver/test
            echo "✅ Removed /etc/resolver/test"
        fi
    fi
    echo "✨ Teardown complete."
}

# Install shell completions into user's profile
install_completion() {
    local shell_name="${SHELL##*/}"
    echo "🔧 Installing './dev' shell completions for ${shell_name}..."

    if [[ "$shell_name" == "zsh" ]]; then
        local zshrc="$HOME/.zshrc"
        if ! grep -q "# localDev CLI completions" "$zshrc" 2>/dev/null; then
            echo "" >> "$zshrc"
            echo "# localDev CLI completions" >> "$zshrc"
            echo "source <($SCRIPT_DIR/dev completion zsh)" >> "$zshrc"
            echo "✅ Added completion loader to $zshrc"
            echo "💡 Run 'source ~/.zshrc' to enable completion in current terminal session."
        else
            echo "ℹ️ Completions already configured in $zshrc"
        fi
    elif [[ "$shell_name" == "bash" ]]; then
        local bashrc="$HOME/.bashrc"
        if ! grep -q "# localDev CLI completions" "$bashrc" 2>/dev/null; then
            echo "" >> "$bashrc"
            echo "# localDev CLI completions" >> "$bashrc"
            echo "source <($SCRIPT_DIR/dev completion bash)" >> "$bashrc"
            echo "✅ Added completion loader to $bashrc"
            echo "💡 Run 'source ~/.bashrc' to enable completion in current terminal session."
        else
            echo "ℹ️ Completions already configured in $bashrc"
        fi
    elif [[ "$shell_name" == "fish" ]]; then
        local fish_dir="$HOME/.config/fish/completions"
        mkdir -p "$fish_dir"
        "$SCRIPT_DIR/dev" completion fish > "$fish_dir/dev.fish"
        echo "✅ Installed fish completions to $fish_dir/dev.fish"
    else
        echo "⚠️ Unsupported shell '$shell_name'. Supported shells: zsh, bash, fish."
    fi
}

# Helper: Determine target PHP container name from version flag or the configured default
get_php_container() {
    local raw_ver="$1"
    case "$raw_ver" in
        8.2|82|php82) echo "local-php82" ;;
        8.3|83|php83) echo "local-php83" ;;
        8.4|84|php84) echo "local-php84" ;;
        8.5|85|php85) echo "local-php85" ;;
        *)          echo "local-$(default_php_version)" ;;
    esac
}

# Helper: Run a tool inside the (optionally version-prefixed) PHP container
run_tool() {
    local tool="$1" raw_ver="" container workdir proj
    shift
    case "${1:-}" in
        8.2|82|8.3|83|8.4|84|8.5|85)
            raw_ver="$1"
            shift
            ;;
    esac
    container="$(get_php_container "$raw_ver")"
    proj="$(detect_current_project)"
    workdir="/var/www/html"
    if [[ -n "$proj" ]]; then
        workdir="/var/www/html/$proj"
    fi
    docker exec -it -w "$workdir" "$container" "$tool" "$@"
}

# Environment snapshot management
snapshot_save() {
    local name=""
    local notes=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --notes=*|-m=*)
                notes="${1#*=}"
                shift
                ;;
            --notes|-m)
                notes="$2"
                shift 2
                ;;
            -*)
                shift
                ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$name" ]]; then
        name="snapshot_$(date +%Y%m%d_%H%M%S)"
    fi

    # Sanitize name
    name="$(printf '%s' "$name" | tr -c 'a-zA-Z0-9_-' '_')"
    mkdir -p "$SNAPSHOTS_DIR"

    local archive="${SNAPSHOTS_DIR}/${name}.tar.gz"
    echo "📸 Creating environment snapshot '${name}'..."

    local tmp_dir
    tmp_dir="$(mktemp -d)"

    # Dump MariaDB if container is running
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-mariadb$"; then
        echo " 📦 Exporting MariaDB databases..."
        docker exec -i local-mariadb mariadb-dump \
            -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
            --all-databases > "$tmp_dir/mariadb_dump.sql" 2>/dev/null || true
    fi

    # Dump PostgreSQL if container is running (never -t: TTY mangles LF into CRLF)
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-postgres$"; then
        echo " 📦 Exporting PostgreSQL databases..."
        docker exec -i local-postgres pg_dumpall -U "$(get_env POSTGRES_USER db_user)" > "$tmp_dir/postgres_dump.sql" 2>/dev/null || true
    fi

    # Dump Redis if container is running
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-redis$"; then
        echo " 📦 Triggering Redis snapshot..."
        docker exec local-redis redis-cli bgsave &>/dev/null || true
    fi

    # Save metadata JSON (values escaped for JSON safety)
    local name_json notes_json
    name_json="$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    notes_json="$(printf '%s' "$notes" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    cat <<EOF > "$tmp_dir/metadata.json"
{
  "name": "$name_json",
  "created_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "notes": "$notes_json",
  "has_mariadb": $( [[ -f "$tmp_dir/mariadb_dump.sql" ]] && echo "true" || echo "false" ),
  "has_postgres": $( [[ -f "$tmp_dir/postgres_dump.sql" ]] && echo "true" || echo "false" )
}
EOF

    tar -czf "$archive" -C "$tmp_dir" .
    rm -rf "$tmp_dir"

    local size
    size=$(du -h "$archive" | cut -f1)
    echo "✅ Snapshot '${name}' saved successfully (${size}) at snapshots/${name}.tar.gz"
}

snapshot_restore() {
    local name=""
    local force=false

    for arg in "$@"; do
        if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
            force=true
        elif [[ -z "$name" && "$arg" != -* ]]; then
            name="$arg"
        fi
    done

    if [[ -z "$name" ]]; then
        echo "❌ Please specify snapshot name to restore."
        snapshot_list
        exit 1
    fi

    local archive="${SNAPSHOTS_DIR}/${name}.tar.gz"
    if [[ ! -f "$archive" ]]; then
        echo "❌ Snapshot '${name}' not found at snapshots/${name}.tar.gz"
        exit 1
    fi

    if [[ "$force" != "true" ]]; then
        echo "⚠️ RESTORE WARNING: Restoring snapshot '${name}' will overwrite active MariaDB/PostgreSQL databases!"
        read -p "Are you sure you want to proceed? (y/N) " confirm
        if [[ "$confirm" != [yY] && "$confirm" != [yY][eE][sS] ]]; then
            echo "Operation cancelled."
            exit 0
        fi
    fi

    echo "📥 Restoring environment snapshot '${name}'..."
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    tar -xzf "$archive" -C "$tmp_dir"

    if [[ -f "$tmp_dir/mariadb_dump.sql" ]]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-mariadb$"; then
            echo " 📥 Restoring MariaDB databases..."
            docker exec -i local-mariadb mariadb \
                -u "$(get_env MARIADB_USER db_user)" -p"$(get_env MARIADB_PASSWORD db_password)" \
                < "$tmp_dir/mariadb_dump.sql" 2>/dev/null || true
            echo " ✅ MariaDB databases restored."
        else
            echo " ⚠️ MariaDB dump found, but 'local-mariadb' container is not running."
        fi
    fi

    if [[ -f "$tmp_dir/postgres_dump.sql" ]]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^local-postgres$"; then
            echo " 📥 Restoring PostgreSQL databases..."
            docker exec -i local-postgres psql -U "$(get_env POSTGRES_USER db_user)" -d postgres \
                < "$tmp_dir/postgres_dump.sql" 2>/dev/null || true
            echo " ✅ PostgreSQL databases restored."
        else
            echo " ⚠️ PostgreSQL dump found, but 'local-postgres' container is not running."
        fi
    fi

    rm -rf "$tmp_dir"
    echo "✨ Snapshot '${name}' restored successfully!"
}

snapshot_list() {
    mkdir -p "$SNAPSHOTS_DIR"
    local files=("$SNAPSHOTS_DIR"/*.tar.gz)

    echo "=========================================="
    echo " 📸 Local Environment Snapshots"
    echo "=========================================="

    if [[ ! -e "${files[0]}" ]]; then
        echo "No snapshots found in ./snapshots/"
        echo "Create one using: ./dev snapshot save <name>"
        return 0
    fi

    printf "%-20s %-10s %-22s %s\n" "NAME" "SIZE" "CREATED AT" "NOTES"
    printf "%-20s %-10s %-22s %s\n" "----" "----" "----------" "-----"

    for file in "${files[@]}"; do
        local bname
        bname=$(basename "$file" .tar.gz)
        local size
        size=$(du -h "$file" | cut -f1)

        local tmp_meta
        tmp_meta=$(tar -xzf "$file" ./metadata.json -O 2>/dev/null || true)
        local created="N/A"
        local notes=""

        if [[ -n "$tmp_meta" ]]; then
            created=$(echo "$tmp_meta" | grep '"created_at"' | cut -d'"' -f4)
            notes=$(echo "$tmp_meta" | grep '"notes"' | cut -d'"' -f4)
        fi

        printf "%-20s %-10s %-22s %s\n" "$bname" "$size" "${created:-N/A}" "${notes:--}"
    done
    echo "=========================================="
}

snapshot_delete() {
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "❌ Please specify snapshot name to delete."
        exit 1
    fi

    local archive="${SNAPSHOTS_DIR}/${name}.tar.gz"
    if [[ ! -f "$archive" ]]; then
        echo "❌ Snapshot '${name}' not found."
        exit 1
    fi

    rm -f "$archive"
    echo "🗑️ Deleted snapshot '${name}'."
}

