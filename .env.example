# ============================================================
# localDev configuration — copy to .env and adjust.
#
# Local laptop:  defaults work as-is. HTTPS certs are auto-generated by
#                ./dev up / ./dev ssl (mkcert when installed for browser-trusted
#                certs, OpenSSL self-signed fallback) — nothing to fill in here.
# VPS / shared:  run ./vps/setup.sh <domain> first (it sets the domain, nginx
#                ports/bind and phpMyAdmin port below), then replace every
#                credential marked [CHANGE ME]. See vps/README.md.
#
# All credentials below are PLAIN TEXT values (normal passwords / API keys) —
# generate strong ones with e.g. `openssl rand -base64 32`. They are unrelated
# to SSL certificates, which are handled automatically.
#
# Values must stay plain — an inline "comment" after a value becomes part of
# the value. Comment lines above a key are fine.
# ============================================================

# Global Settings
PROJECTS_PATH=./projects
DEFAULT_PHP_VERSION=php85
# Domain suffix for project URLs (use a real domain on a VPS, e.g. dev.example.com)
DOMAIN_SUFFIX=test
# Suffix as a nginx-safe regex (dots as [.] to avoid escaping issues, e.g. dev[.]example[.]com)
DOMAIN_SUFFIX_REGEX=test
SYSTEM_TIMEZONE=
XDEBUG_MODE=off
COMPOSE_PARALLEL_LIMIT=1

# Port Mappings
# Bind address for the web UIs (Mailpit, phpMyAdmin, pgAdmin, Redis Commander,
# Meilisearch) — 127.0.0.1 keeps them SSH-tunnel-only; set a Tailscale/VCN IP
# when a reverse proxy on another host should reach them
TOOLS_BIND_IP=127.0.0.1
NGINX_BIND_IP=0.0.0.0
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443
NGINX_PORT_PHP82=8082
NGINX_PORT_PHP83=8083
NGINX_PORT_PHP84=8084
NGINX_PORT_PHP85=8085
DNSMASQ_PORT=5354

MARIADB_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379

PHPMYADMIN_PORT=8080
PGADMIN_PORT=8081
REDIS_COMMANDER_PORT=8086
MAILPIT_PORT_UI=8025
MAILPIT_PORT_SMTP=1025

MEILISEARCH_PORT=7700

# Meilisearch Credentials
# [CHANGE ME] before deploying on a shared/VPS machine.
# MEILISEARCH_MASTER_KEY — API key apps send to Meilisearch; any long random
#   string. Not a login password and not a certificate.
MEILISEARCH_MASTER_KEY=masterKey

# MariaDB (MySQL) Settings
# [CHANGE ME] plain passwords for the root and app logins (used by apps,
# ./dev db and phpMyAdmin). MARIADB_DATABASE is just the default database name.
# Both accounts are admins: MARIADB_USER gets a full global grant on first init
# (see mariadb/init/), like PostgreSQL's superuser POSTGRES_USER.
# Applied only when the data volume is first created — set before the first
# ./dev up (or reset the volume to change later).
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=local_db
MARIADB_USER=db_user
MARIADB_PASSWORD=db_password

# PostgreSQL Settings
# [CHANGE ME] plain password for POSTGRES_USER (the admin role apps and
# ./dev db connect with). POSTGRES_DB is the default database name.
# Also applied only on first creation of the data volume.
POSTGRES_DB=local_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password

# pgAdmin Settings
# [CHANGE ME] normal email + password login for the pgAdmin web UI (:8081).
# Applied only on first startup of the pgAdmin volume.
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=adminpassword

# Container Resource Limits
DNSMASQ_MEM_LIMIT=64m
NGINX_MEM_LIMIT=256m
PHP82_MEM_LIMIT=512m
PHP83_MEM_LIMIT=512m
PHP84_MEM_LIMIT=512m
PHP85_MEM_LIMIT=512m
MARIADB_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m
MAILPIT_MEM_LIMIT=128m
PHPMYADMIN_MEM_LIMIT=256m
PGADMIN_MEM_LIMIT=256m
REDIS_COMMANDER_MEM_LIMIT=128m
MEILISEARCH_MEM_LIMIT=512m

# Private Tailscale Configuration (values must never be empty — nginx requires them)
TAILSCALE_DOMAIN=myservice.tail000000.ts.net
TAILSCALE_PROJECT_PATH=dashboard
